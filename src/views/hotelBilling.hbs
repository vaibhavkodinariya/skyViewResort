<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hotel Invoice (Landscape)</title>
    <style>
        body {
            font-family: "Arial", sans-serif;
            margin: 0;
            padding: 0;
        }

        .invoice-container {
            width: 100%;
            max-width: 900px;
            margin: 20px auto;
            padding: 20px;
            background: #ffffff;
            border: 3px solid #c6932d;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .header .partner-logo {
            flex: 1;
            text-align: left;
        }

        .header .hotel-logo {
            flex: 2;
            text-align: center;
        }

        .header .hotel-logo img {
            max-height: 100px;
        }

        .header .details {
            flex: 1;
            text-align: right;
        }

        .header .details h1 {
            margin: 0;
            font-size: 20px;
            color: #c6932d;
        }

        .header .details p {
            margin: 3px 0;
            font-size: 13px;
            color: #333;
        }

        hr {
            border: none;
            border-top: 2px solid #c6932d;
            margin: 20px 0;
        }

        .content {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .content .customer-details,
        .content .invoice-details {
            font-size: 14px;
        }

        .content .customer-details p,
        .content .invoice-details p {
            margin: 5px 0;
        }

        .content .invoice-details {
            text-align: right;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        table th,
        table td {
            padding: 10px 15px;
            font-size: 14px;
            text-align: left;
            border: 1px solid #ddd;
        }

        table th {
            background-color: #c6932d;
            color: #ffffff;
        }

        table .total-row td {
            font-weight: bold;
            border-top: 2px solid #c6932d;
        }

        .footer {
            text-align: center;
            font-size: 13px;
            color: #333;
        }

        .footer .thankyou {
            font-size: 15px;
            color: #c6932d;
            font-weight: bold;
        }

        .footer .qr-code {
            margin-top: 10px;
        }

        .footer .qr-code img {
            max-height: 80px;
        }
    </style>
</head>

<body>
    <div class="invoice-container">
        <!-- Header -->
        <div class="header">
            <div class="partner-logo">
                <img src="{{partnerLogo}}" width="80px" alt="Partner Logo" />
            </div>
            <div class="hotel-logo">
                <img src="{{hotelLogo}}" width="300px" alt="Hotel Logo" />
            </div>
            <div class="details">
                <h1>Sky View Resort</h1>
                <p>XYZ Colony,Bhuj</p>
                <p><strong>Phone:</strong> 3848384438</p>
            </div>
        </div>

        <hr />

        <!-- Content -->
        <div class="content">
            <div class="customer-details">
                <p><strong>Customer Name:</strong> {{customerName}}</p>
                <p><strong>Room No:</strong> {{roomNumber}}</p>
                <p><strong>Check-in:</strong> {{checkIn}}</p>
                <p><strong>Check-out:</strong> {{checkOut}}</p>
            </div>
            <div class="invoice-details">
                <p><strong>Invoice No:</strong> {{invoiceNumber}}</p>
                <p><strong>Date:</strong> {{invoiceDate}}</p>
                <p><strong>Payment Method:</strong> {{paymentMethod}}</p>
            </div>
        </div>

        <!-- Table -->
        <table>
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Unit Price (₹)</th>
                    <th>Total (₹)</th>
                </tr>
            </thead>
            <tbody>
                {{#each items}}
                <tr>
                    <td>{{description}}</td>
                    <td>{{unitPrice}}</td>
                    <td>{{total}}</td>
                </tr>
                {{/each}}
            </tbody>
            <tfoot>
                {{#if discount}}
                <tr>
                    <td colspan="2">Discount</td>
                    <td>- {{discount}}</td>
                </tr>
                {{/if}}
                <tr class="total-row">
                    <td colspan="2">Subtotal</td>
                    <td>{{subtotal}}</td>
                </tr>
                <tr>
                    <td colspan="2">GST (12%)</td>
                    <td>{{gst}}</td>
                </tr>
                <tr class="total-row">
                    <td colspan="2">Final Total</td>
                    <td><span style="color: #c6932d">₹{{grandTotal}}</span></td>
                </tr>
            </tfoot>
        </table>

        <!-- Footer -->
        <div class="footer">
            <p class="thankyou">Thank you for staying with us!</p>
            <p>We hope to see you again soon.</p>
        </div>
    </div>
</body>

</html>
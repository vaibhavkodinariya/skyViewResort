<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hotel Invoice (Landscape)</title>
    <style>
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .hotel-logo img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        .details {
            text-align: right;
            flex-shrink: 0;
        }

        .hotel-logo {
            flex-shrink: 0;
            width: auto;
        }

        .page {
            font-family: "Arial", sans-serif;
            margin: 0;
            padding: 0;
        }

        .container {
            width: 100%;
            max-width: 900px;
            margin: 20px auto;
            padding: 20px;
            background: #ffffff;
            border: 3px solid #c6932d;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .flex {
            display: flex;
        }

        .space-between {
            justify-content: space-between;
        }

        .align-center {
            align-items: center;
        }

        .text-left {
            text-align: left;
        }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        .text-bold {
            font-weight: bold;
        }

        .text-highlight {
            color: #c6932d;
        }

        .margin-bottom {
            margin-bottom: 20px;
        }

        .header img {
            max-height: 100px;
        }

        .details-title {
            margin: 0;
            font-size: 20px;
            color: #c6932d;
        }

        .details-text {
            margin: 3px 0;
            font-size: 13px;
            color: #333;
        }

        .divider {
            border: none;
            border-top: 2px solid #c6932d;
            margin: 20px 0;
        }

        .details-paragraph {
            font-size: 14px;
            margin: 5px 0;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        .table-header,
        .table-data {
            padding: 10px 15px;
            font-size: 14px;
            text-align: left;
            border: 1px solid #ddd;
        }

        .table-header {
            background-color: #c6932d;
            color: #ffffff;
        }

        .total-row {
            font-weight: bold;
            border-top: 2px solid #c6932d;
        }

        .footer {
            text-align: center;
            font-size: 13px;
            color: #333;
        }

        .thankyou {
            font-size: 15px;
            color: #c6932d;
            font-weight: bold;
        }

        .qr-code img {
            max-height: 80px;
        }
    </style>
</head>

<body class="page">
    <div class="container">
        <!-- Header -->
        <div class="header">
            <!-- Hotel Logo (replaced partner logo with SkyView logo) -->
            <div class="hotel-logo">
                <img src="{{hotelLogo}}" alt="SkyView Logo" width="200px" height="auto" />
            </div>
            <!-- Details -->
            <div class="details">
                <h1 class="details-title">{{hotelName}}</h1>
                <p class="details-text">
                    {{hotelAddress}}
                </p>
                <p class="details-text">
                    <strong>Phone:</strong> {{hotelPhone}}
                </p>
            </div>
        </div>
        <hr class="divider" />

        <!-- Content -->
        <div class="content flex space-between margin-bottom">
            <div class="customer-details text-left">
                {{#if customerName}}
                <p class="details-paragraph"><strong>Customer Name:</strong> {{customerName}}</p>
                {{/if}}
                {{#if businessName}}
                <p class="details-paragraph"><strong>Business Name:</strong> {{businessName}}</p>
                {{/if}}
                {{#if businessGSTIN}}
                <p class="details-paragraph"><strong>Business GSTIN:</strong> {{businessGSTIN}}</p>
                {{/if}}
                <p class="details-paragraph"><strong>Room No:</strong> {{roomNumber}}</p>
                <p class="details-paragraph"><strong>Check-in:</strong> {{checkIn}}</p>
                <p class="details-paragraph"><strong>Check-out:</strong> {{checkOut}}</p>
            </div>
            <div class="invoice-details text-right">
                <p class="details-paragraph"><strong>Invoice No:</strong> {{invoiceNumber}}</p>
                <p class="details-paragraph"><strong>Date:</strong> {{invoiceDate}}</p>
                <p class="details-paragraph"><strong>Payment Method:</strong> {{paymentMethod}}</p>
                <p class="details-paragraph"><strong>GSTIN:</strong> {{skyViewGSTNo}}</p>
            </div>
        </div>

        <!-- Table -->
        <table class="table">
            <thead>
                <tr>
                    <th class="table-header">Description</th>
                    <th class="table-header">Unit Price (₹)</th>
                    <th class="table-header">Total (₹)</th>
                </tr>
            </thead>
            <tbody>
                {{#each items}}
                <tr>
                    <td class="table-data">{{description}}</td>
                    <td class="table-data">{{unitPrice}}</td>
                    <td class="table-data">{{total}}</td>
                </tr>
                {{/each}}
            </tbody>
            <tfoot>
                {{#if discount}}
                <tr>
                    <td colspan="2" class="table-data">Discount</td>
                    <td class="table-data">- {{discount}}</td>
                </tr>
                {{/if}}
                <tr class="total-row">
                    <td colspan="2" class="table-data">Subtotal</td>
                    <td class="table-data">{{subtotal}}</td>
                </tr>
                <tr>
                    <td colspan="2" class="table-data">GST (12%)</td>
                    <td class="table-data">{{gst}}</td>
                </tr>
                <tr class="total-row">
                    <td colspan="2" class="table-data">Final Total</td>
                    <td class="table-data"><span class="text-highlight">₹{{grandTotal}}</span></td>
                </tr>
            </tfoot>
        </table>

        <!-- Footer -->
        <div class="footer">
            <p class="thankyou">Thank you for staying with us!</p>
            <p>We hope to see you again soon.</p>
        </div>
    </div>
</body>

</html>